# Copie para .env para sobrescrever os padroes do docker-compose.yml.
# Todos os valores abaixo ja sao os padroes, so descomente o que quiser mudar.

# RABBITMQ_USER=fcg
# RABBITMQ_PASSWORD=fcg_password
# RABBITMQ_AMQP_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672

# POSTGRES_USER=fcg
# POSTGRES_PASSWORD=fcg_password
# Porta do host (dentro da rede do compose o Postgres sempre responde na 5432).
# POSTGRES_HOST_PORT=5435
