# ATENCAO: a extensao .example e proposital. `kubectl apply -f k8s/` le so *.yaml, *.yml e *.json, entao
# este modelo nunca e aplicado por engano (o que trocaria a chave real pelo texto de exemplo).
# MODELO. A chave de verdade nao fica no git: o script create-jwt-secret.sh cria este mesmo Secret a
# partir do .env (JWT__SIGNINGKEY). Existe um unico Secret com a chave, consumido por users-api (emite)
# e por catalog-api e payments-api (apenas validam), por isso ela e a mesma nos tres.
apiVersion: v1
kind: Secret
metadata:
  name: jwt-signing-key
  namespace: fcg
  labels:
    app.kubernetes.io/part-of: fcg
type: Opaque
stringData:
  JWT__SIGNINGKEY: TROQUE-POR-UMA-CHAVE-DE-PELO-MENOS-32-CARACTERES   # openssl rand -hex 32
